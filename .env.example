# TrueForge harness
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=openai/gpt-5.2
# TRUEFORGE_TOKEN=...            # only when OIDC login is enabled

# cloud-fabric server
FABRIC_PROVIDER=synthetic        # synthetic | aws
FABRIC_SEED=42
FABRIC_PAGE_SIZE=500
FABRIC_MAX_PAGE_SIZE=1000
FABRIC_HOST=127.0.0.1
FABRIC_PORT=9000
FABRIC_BILLING_DAYS=30
FABRIC_METRICS_WINDOW_DAYS=14
# FABRIC_DEGRADED_DOMAINS=k8s    # simulate partial collection failure (flow Step 2.5)

# AWS opt-in adapter (only your own account; read-only IAM strongly advised)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
